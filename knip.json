{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": [
    "src/app/**/{page,layout,loading,error,not-found,route}.{ts,tsx}",
    "src/server/trigger/**/index.ts",
    "src/components/ui/**/*.{ts,tsx}",
    "src/lib/types/ids.ts",
    "src/server/actions/**/*.ts",
    "src/lib/meta/index.ts",
    "src/lib/meta/endpoints.ts",
    "trigger.config.ts"
  ],
  "project": ["src/**/*.{ts,tsx}"],
  "ignoreDependencies": [
    "server-only",
    "postcss",
    "@radix-ui/react-label",
    "tw-animate-css",
    "shadcn",
    "@trigger.dev/core"
  ],
  "ignoreExportsUsedInFile": true,
  "ignoreFiles": ["src/**/__tests__/**", "src/**/__smoke__.*"]
}
