{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": [
    "src/app/**/{page,layout,loading,error,not-found,route}.{ts,tsx}",
    "src/server/trigger/**/index.ts",
    "src/components/ui/**/*.{ts,tsx}",
    "trigger.config.ts"
  ],
  "project": ["src/**/*.{ts,tsx}"],
  "ignoreDependencies": [
    "server-only",
    "postcss",
    "@radix-ui/react-label",
    "bun-types",
    "tw-animate-css",
    "shadcn"
  ],
  "ignoreBinaries": ["trigger"],
  "ignoreExportsUsedInFile": true,
  "ignoreFiles": [
    "drizzle.config.ts",
    "src/__tests__/**",
    "src/**/__smoke__.*"
  ]
}
