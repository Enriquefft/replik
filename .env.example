# Database
DATABASE_URL=

# Auth
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Force Clerk to use the in-app custom sign-in/sign-up routes instead of the
# hosted account portal (accounts.dev). Required on every environment.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Background jobs
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_ID=

# LLM
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Apify (FB Ads fallback)
APIFY_TOKEN=

# UploadThing (asset hosting)
UPLOADTHING_TOKEN=

# Meta Ad Library (server-side, post developer identity verification)
META_AD_LIBRARY_TOKEN=

# Symmetric key for pgcrypto pgp_sym_encrypt (32-byte random)
ENCRYPTION_KEY=
